{
  "expo": {
    "name": "PetConnect",
    "slug": "petconnect",
    "scheme": "petconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "O PetConnect precisa acessar suas fotos para incluir imagens nos anúncios de adoção."
        }
      ]
    ]
  }
}
